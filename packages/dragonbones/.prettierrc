{
	"printWidth": 180,
	"tabWidth": 4,
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "all",
	"bracketSpacing": true,
	"arrowParens": "avoid",
	"proseWrap": "preserve",
	"htmlWhitespaceSensitivity": "ignore",
	"overrides": [
		{
			"files": "**/Conf.js",
			"options": {
				"singleQuote": false
			}
		}
	]
}
