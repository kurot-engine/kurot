{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "dist",
		"rootDir": "src",
		"declaration": true,
		"declarationMap": true,
		"preserveConstEnums": true,
		"noEmitOnError": true,
		"sourceMap": true,
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"noImplicitOverride": true
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}
