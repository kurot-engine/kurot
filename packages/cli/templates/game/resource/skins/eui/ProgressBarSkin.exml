<?xml version="1.0" encoding="utf-8"?>
<eui:Skin class="skins.ProgressBarSkin" minWidth="30" minHeight="18"
    xmlns:eui="http://ns.egret.com/eui">
    <eui:Image source="track_pb_png" scale9Grid="1,1,4,4"
        width="100%" height="100%" verticalCenter="0"/>
    <eui:Image id="thumb" source="thumb_pb_png" scale9Grid="1,1,4,4"
        width="100%" height="100%"/>
    <eui:Label id="labelDisplay" textAlign="center" verticalAlign="middle"
        size="15" fontFamily="Tahoma" textColor="0x707070"
        horizontalCenter="0" verticalCenter="0"/>
</eui:Skin>
