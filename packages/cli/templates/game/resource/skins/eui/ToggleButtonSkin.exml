<?xml version="1.0" encoding="utf-8"?>
<eui:Skin class="skins.ToggleButtonSkin"
    states="up,down,disabled,upAndSelected,downAndSelected,disabledAndSelected"
    minWidth="100" minHeight="50"
    xmlns:eui="http://ns.egret.com/eui">
    <eui:Rect id="bg" width="100%" height="100%"
        fillColor="0x636e72"
        fillColor.down="0x4a5459"
        fillColor.disabled="0x2d3436"
        fillColor.upAndSelected="0x6c5ce7"
        fillColor.downAndSelected="0x5a4bd1"
        fillColor.disabledAndSelected="0x2d3436"
        strokeColor="0x4a5459"
        strokeWeight="1"/>
    <eui:Label id="labelDisplay" left="8" right="8" top="8" bottom="8"
        textAlign="center" verticalAlign="middle"
        textColor="0xdfe6e9"
        textColor.disabled="0x636e72"
        textColor.upAndSelected="0xffffff"
        size="16"/>
</eui:Skin>
