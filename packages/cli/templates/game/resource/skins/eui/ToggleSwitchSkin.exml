<?xml version="1.0" encoding="utf-8"?>
<eui:Skin class="skins.ToggleSwitchSkin"
    states="up,down,disabled,upAndSelected,downAndSelected,disabledAndSelected"
    xmlns:eui="http://ns.egret.com/eui">
    <eui:Image source="on_png"
        source.up="off_png"
        source.down="off_png"
        source.disabled="off_png"/>
    <eui:Image source="handle_png"
        horizontalCenter="-18"
        horizontalCenter.upAndSelected="18"
        horizontalCenter.downAndSelected="18"
        horizontalCenter.disabledAndSelected="18"
        verticalCenter="0"/>
</eui:Skin>
