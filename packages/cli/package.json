{
	"name": "@kurot/cli",
	"version": "1.1.1",
	"description": "Kurot CLI - build tool for the Kurot game engine",
	"author": "Kelvin <kyia.x52@gmail.com>",
	"license": "MIT",
	"type": "module",
	"main": "./dist/define.js",
	"types": "./dist/define.d.ts",
	"bin": {
		"kurot": "./dist/index.js"
	},
	"files": [
		"dist",
		"templates",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc --build",
		"dev": "tsc --watch",
		"clean": "rm -rf dist",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "npm run clean && npm run build",
		"kurot": "tsx src/index.ts"
	},
	"dependencies": {
		"commander": "^13.0.0",
		"esbuild": "^0.25.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsx": "^4.21.0",
		"typescript": "^5.6.0",
		"vitest": "^4.1.4"
	},
	"keywords": [
		"kurot",
		"cli",
		"game-engine",
		"exml",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kurot-engine/kurot.git",
		"directory": "packages/cli"
	},
	"packageManager": "pnpm@10.33.0",
	"publishConfig": {
		"access": "public"
	}
}
