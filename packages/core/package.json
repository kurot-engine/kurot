{
	"name": "@kurot/core",
	"version": "2.0.1",
	"description": "Modern rewrite of the Egret game engine — WebGL multi-texture batching, instruction-driven render pipeline, strict TypeScript, Egret-compatible API",
	"author": "Kelvin <kyia.x52@gmail.com>",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist/**/*",
		"docs/**/*",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc --build && npm run build:types",
		"build:types": "tsc --emitDeclarationOnly --declaration --declarationMap",
		"dev": "tsc --watch",
		"clean": "rm -rf dist",
		"test": "vitest run",
		"test:visual": "playwright test --config examples/visual-regression/playwright.config.ts",
		"test:visual:update": "playwright test --config examples/visual-regression/playwright.config.ts --update-snapshots",
		"test:watch": "vitest",
		"prepublishOnly": "npm run clean && npm run build",
		"benchmark": "vite --config vite.config.ts",
		"benchmark:compare": "playwright test --config examples/benchmark/playwright.config.ts",
		"benchmark:smoke": "BENCHMARK_PROFILE=smoke playwright test --config examples/benchmark/playwright.config.ts",
		"test:soak": "playwright test --config examples/benchmark/soak.playwright.config.ts",
		"test:soak:30m": "SOAK_DURATION_MINUTES=30 playwright test --config examples/benchmark/soak.playwright.config.ts",
		"test:soak:2h": "SOAK_DURATION_MINUTES=120 playwright test --config examples/benchmark/soak.playwright.config.ts",
		"test:soak:overnight": "SOAK_DURATION_MINUTES=480 playwright test --config examples/benchmark/soak.playwright.config.ts",
		"test:device-matrix": "playwright test --config examples/benchmark/device-matrix.playwright.config.ts",
		"build:benchmark": "vite --config vite.config.ts build",
		"preview:benchmark": "vite preview --config vite.config.ts --host 0.0.0.0 --port 4173"
	},
	"devDependencies": {
		"@playwright/test": "1.62.1",
		"@types/node": "^22.0.0",
		"fast-check": "^4.6.0",
		"happy-dom": "^20.8.9",
		"pixi.js": "8.20.0",
		"typescript": "^5.6.0",
		"vite": "^8.0.8",
		"vitest": "^4.1.4"
	},
	"keywords": [
		"kurot",
		"h5-game",
		"webgl",
		"webgpu",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kurot-engine/kurot.git",
		"directory": "packages/core"
	},
	"packageManager": "pnpm@10.33.0",
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@cto.af/linebreak": "4.0.3"
	}
}
