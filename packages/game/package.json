{
	"name": "@kurot/game",
	"version": "1.0.6",
	"description": "Game extensions for the Kurot engine — Tween, Ease, MovieClip, ScrollView, URLLoader",
	"author": "Kelvin <kyia.x52@gmail.com>",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist/**/*",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc --build",
		"dev": "tsc --watch",
		"clean": "rm -rf dist",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"peerDependencies": {
		"@kurot/core": "^1.0.12"
	},
	"devDependencies": {
		"@kurot/core": "^1.0.12",
		"@types/node": "^22.0.0",
		"happy-dom": "^20.8.9",
		"typescript": "^5.6.0",
		"vitest": "^4.1.4"
	},
	"keywords": [
		"kurot",
		"game",
		"tween",
		"movieclip",
		"h5-game",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kurot-engine/kurot.git",
		"directory": "packages/game"
	},
	"packageManager": "pnpm@10.33.0",
	"publishConfig": {
		"access": "public"
	}
}
