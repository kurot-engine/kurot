{
	"name": "@kurot/ui",
	"version": "3.3.1",
	"description": "EUI-compatible UI component framework for the Kurot game engine — skin-based components, layouts, data binding, view states",
	"author": "Kelvin <kyia.x52@gmail.com>",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist/**/*",
		"docs/**/*",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc --build",
		"dev": "tsc --watch",
		"clean": "rm -rf dist",
		"test": "vitest run --config vitest.config.ts",
		"test:watch": "vitest --config vitest.config.ts",
		"benchmark": "vite --config vite.config.ts",
		"benchmark:compare": "playwright test --config examples/benchmark/playwright.config.ts",
		"benchmark:smoke": "UI_BENCHMARK_PROFILE=smoke playwright test --config examples/benchmark/playwright.config.ts",
		"build:benchmark": "vite --config vite.config.ts build",
		"prepublishOnly": "npm run clean && npm run build",
		"test:text-labels": "playwright test test/browser --workers=1"
	},
	"peerDependencies": {
		"@kurot/core": "^2.3.0"
	},
	"devDependencies": {
		"@kurot/core": "^2.3.1",
		"@playwright/test": "1.62.1",
		"@types/node": "^22.0.0",
		"esbuild": "^0.28.2",
		"happy-dom": "^20.8.9",
		"typescript": "^5.6.0",
		"vite": "^8.0.8",
		"vitest": "^4.1.4"
	},
	"keywords": [
		"kurot",
		"ui",
		"eui",
		"skin",
		"h5-game",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kurot-engine/kurot.git",
		"directory": "packages/ui"
	},
	"packageManager": "pnpm@10.33.0",
	"publishConfig": {
		"access": "public"
	}
}
