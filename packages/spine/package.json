{
	"name": "@kurot/spine",
	"version": "0.2.3",
	"description": "Spine 4.3 runtime for the Kurot engine",
	"author": "",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist/**/*"
	],
	"scripts": {
		"build": "tsc --build",
		"dev": "tsc --watch",
		"example": "vite --config vite.config.ts",
		"clean": "rm -rf dist",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@esotericsoftware/spine-core": "^4.3.0"
	},
	"peerDependencies": {
		"@kurot/core": "^1.0.12"
	},
	"devDependencies": {
		"@kurot/core": "^1.0.12",
		"@types/node": "^22.0.0",
		"typescript": "^5.6.0",
		"vite": "^8.0.8"
	},
	"keywords": [
		"kurot",
		"spine",
		"h5-game",
		"typescript"
	],
	"packageManager": "pnpm@10.33.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kurot-engine/kurot.git",
		"directory": "packages/spine"
	},
	"publishConfig": {
		"access": "public"
	}
}
