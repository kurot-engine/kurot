{
	"name": "kurot-star-catcher",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": { "node": ">=22.12.0" },
	"scripts": {
		"dev": "kurot dev",
		"build": "kurot build",
		"release": "kurot build --release",
		"typecheck": "tsc --noEmit",
		"test": "vitest run test/model.test.ts",
		"test:browser": "node --import tsx tools/browser-check.ts",
		"check": "pnpm typecheck && pnpm test && pnpm build && pnpm release && pnpm test:browser"
	},
	"dependencies": {
		"@kurot/core": "3.2.3"
	},
	"devDependencies": {
		"@kurot/cli": "5.0.0",
		"@playwright/test": "1.62.1",
		"@types/node": "22.19.17",
		"tsx": "4.21.0",
		"typescript": "5.9.3",
		"vitest": "4.1.4"
	},
	"packageManager": "pnpm@10.33.0"
}
