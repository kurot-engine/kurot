<?xml version="1.0" encoding="utf-8"?>
<Skin xmlns="https://kurot.dev/ui/1" id="skins.ComboBoxSkin" version="2" target="kui.ComboBox" default="true">
    <contract>
        <parts>
            <part name="dropDown" node="dropDown" />
            <part name="labelDisplay" node="labelDisplay" />
            <part name="list" node="list" />
        </parts>
        <states>
            <state name="disabled">
                <set target="node_rect1" property="fillColor" value="1450302" />
                <set target="node_rect1" property="strokeColor" value="4871257" />
                <set target="labelDisplay" property="textColor" value="6516338" />
            </state>
            <state name="normal">
            </state>
            <state name="open">
                <set target="node_rect1" property="fillColor" value="1450302" />
                <set target="node_rect1" property="strokeColor" value="7101671" />
                <set target="node_label2" property="textColor" value="7101671" />
            </state>
        </states>
    </contract>
    <Group id="root" minHeight="36" minWidth="100">
        <Rect id="node_rect1" fillColor="1710638" height="36" strokeColor="996448" strokeWeight="1" width="100%" />
        <Label id="labelDisplay" height="36" left="10" right="36" size="14" textColor="14673641" top="0" verticalAlign="middle" />
        <Label id="node_label2" height="36" right="4" size="10" text="▼" textAlign="center" textColor="6516338" top="0" verticalAlign="middle" width="24" />
        <Scroller id="dropDown" height="180" left="0" right="0" top="36" visible="false">
            <List id="list" height="180" width="100%" />
        </Scroller>
    </Group>
</Skin>
