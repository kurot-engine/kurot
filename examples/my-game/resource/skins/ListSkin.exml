<?xml version="1.0" encoding="utf-8"?>
<eui:Skin class="skins.ListSkin" minWidth="20" minHeight="20"
    xmlns:eui="http://ns.egret.com/eui">
    <eui:Rect width="100%" height="100%"
        fillColor="0x1a1a2e"
        strokeColor="0x0f3460"
        strokeWeight="1"/>
