<?xml version="1.0" encoding="utf-8"?>
<eui:Skin class="skins.ComboBoxSkin" minWidth="100" minHeight="36"
    states="normal,open,disabled"
    xmlns:eui="http://ns.egret.com/eui">
    <!-- Trigger background -->
    <eui:Rect width="100%" height="36"
        fillColor="0x1a1a2e"
        fillColor.open="0x16213e"
        fillColor.disabled="0x16213e"
        strokeColor="0x0f3460"
        strokeColor.open="0x6c5ce7"
        strokeColor.disabled="0x4a5459"
        strokeWeight="1"/>
    <!-- Selected item label -->
    <eui:Label id="labelDisplay" left="10" right="36" top="0" height="36"
        verticalAlign="middle"
        textColor="0xdfe6e9"
        textColor.disabled="0x636e72"
        size="14"/>
    <!-- Dropdown arrow indicator -->
    <eui:Label right="4" top="0" width="24" height="36"
        textAlign="center" verticalAlign="middle"
        textColor="0x636e72"
        textColor.open="0x6c5ce7"
        text="▼"
        size="10"/>
    <!-- Dropdown panel -->
    <eui:Scroller id="dropDown" left="0" right="0" top="36" height="180" visible="false">
        <eui:List id="list" width="100%" height="180"/>
    </eui:Scroller>
</eui:Skin>
