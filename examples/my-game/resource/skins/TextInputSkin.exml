<?xml version="1.0" encoding="utf-8"?>
<eui:Skin class="skins.TextInputSkin" minWidth="300" minHeight="40"
    states="normal,disabled,normalWithPrompt,disabledWithPrompt"
    xmlns:eui="http://ns.egret.com/eui">
    <eui:Rect width="100%" height="100%"
        fillColor="0xffffff"
        alpha.disabled="0.5"/>
    <eui:EditableText id="textDisplay"
        left="10" right="10" verticalCenter="0" height="24"
        verticalAlign="middle"
        textColor="0x000000"
        textColor.disabled="0xff0000"
        size="20"/>
    <eui:Label id="promptDisplay"
        left="10" right="10" verticalCenter="0" height="24"
        touchEnabled="false"
        includeIn="normalWithPrompt,disabledWithPrompt"
        multiline="false" wordWrap="false"
        verticalAlign="middle"
        textColor="0xa9a9a9"
        size="20"/>
</eui:Skin>
