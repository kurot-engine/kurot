# Dependencies and package-manager data
node_modules/
.pnpm-store/

# Generated build artifacts
dist/
build/
benchmark-dist/
bin-debug/
bin-release/
coverage/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*
*.local
!.env.example

# Editor and operating-system files
.DS_Store
Thumbs.db
.vscode/
