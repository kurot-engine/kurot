# Dependencies and package-manager data
node_modules/
.pnpm-store/

# Generated build artifacts
dist/
build/
packages/core/examples/benchmark/dist/
packages/core/examples/benchmark/results/
packages/ui/examples/benchmark/results/
test-results/
bin-debug/
bin-release/
coverage/
*.tsbuildinfo

# Generated Agent Eval results (keep the directory documentation)
agent-evals/reports/*
!agent-evals/reports/README.md

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*
*.local
!.env.example

# Editor and operating-system files
.DS_Store
Thumbs.db
.vscode/
.idea/
.zed/
.claude/
*.swp
*.swo

# Local reference material (read-only, not distributed)
/reference/

# Internal-only documentation (design drafts, reviews, audits) — not
# distributed via git. Public docs live in each package's docs/ folder.
# This pattern (no leading slash) matches docs-internal/ at any depth,
# so it covers the root and every package's docs-internal/ folder.
docs-internal/
