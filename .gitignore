# Local reference material (read-only, not distributed)
/reference/

# Internal-only documentation (design drafts, reviews, audits) — not
# distributed via git. Public docs live in each package's docs/ folder.
# This pattern (no leading slash) matches docs-internal/ at any depth,
# so it covers the root and every package's docs-internal/ folder.
docs-internal/
