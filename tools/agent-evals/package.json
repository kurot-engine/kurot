{
	"name": "@kurot/agent-evals",
	"version": "0.0.0",
	"description": "Internal Agent evaluation harness for the Kurot game engine",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc --build",
		"dev": "tsc --watch",
		"clean": "rm -rf dist coverage",
		"test": "vitest run --exclude \"reports/**\" --exclude \"test/oracle.test.ts\"",
		"test:oracle": "vitest run test/oracle.test.ts --exclude \"reports/**\"",
		"compare:docs": "node --import ../../examples/star-catcher/node_modules/tsx/dist/loader.mjs src/comparison/run.ts",
		"calibrate:suite": "node --import ../../examples/star-catcher/node_modules/tsx/dist/loader.mjs src/suite/calibrate.ts",
		"compare:suite": "node --import ../../examples/star-catcher/node_modules/tsx/dist/loader.mjs src/suite/run.ts",
		"test:watch": "vitest --exclude \"reports/**\" --exclude \"test/oracle.test.ts\""
	},
	"dependencies": {
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"typescript": "^5.6.0",
		"vitest": "^4.1.4"
	},
	"packageManager": "pnpm@10.33.0"
}
