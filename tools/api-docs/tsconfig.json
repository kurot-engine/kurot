{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"skipLibCheck": true,
		"rootDir": ".",
		"outDir": "dist",
		"types": [
			"node"
		],
		"forceConsistentCasingInFileNames": true
	},
	"include": [
		"src/**/*.ts",
		"test/**/*.ts"
	]
}
