{
	"name": "@kurot/api-docs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc --build",
		"generate": "node dist/src/run.js generate",
		"check": "node dist/src/run.js check",
		"test": "node --test dist/test/*.test.js",
		"check:examples": "node dist/src/examples.js",
		"check:package": "node dist/src/pack.js",
		"html": "node dist/src/run.js html",
		"verify": "tsc --build && node --test dist/test/*.test.js && node dist/src/run.js check && node dist/src/examples.js && node dist/src/pack.js"
	},
	"dependencies": {
		"typedoc": "0.28.14",
		"typescript": "5.9.3"
	},
	"devDependencies": {
		"@types/node": "22.19.17"
	},
	"packageManager": "pnpm@10.33.0"
}
